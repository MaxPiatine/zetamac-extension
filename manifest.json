{
  "manifest_version": 3,
  "name": "Zetamac Session Recorder",
  "version": "1.0",
  "description": "Records Zetamac sessions with response-time heatmap and error tracking",
  "permissions": ["storage", "activeTab", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zetamac Recorder"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://arithmetic.zetamac.com/*"],
      "js": ["content.js"]
    }
  ]
}
